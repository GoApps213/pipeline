require "json"
require "tmpdir"

default_platform(:ios)

KEYCHAIN = "pipeline-signing"

# The project being released: its checkout and its .agent/project.json, which names the Xcode
# project, scheme, bundle ID and team. Set by the release workflow.
PROJECT_DIR = ENV.fetch("PROJECT_DIR")
PROJECT = JSON.parse(File.read(File.join(PROJECT_DIR, ".agent/project.json")))
CERTS_REPO = PROJECT.fetch("certificates_repo", "https://github.com/GoApps213/ios-certs.git")

# Adds a line to the timeline of every ticket in this build (TICKETS is set by the
# release workflow; a local run has none). Never fails the build.
def progress(message)
  status = File.expand_path("../scripts/status.sh", __dir__)
  ENV["TICKETS"].to_s.split.each { |n| sh(status, n, "building", message) }
rescue => e
  UI.important("Could not post progress: #{e.message}")
end

# Archives and exports with xcodebuild itself, for a project in Xcode 27's format (project.xcproj),
# which build_app can't read: its xcodeproj gem knows only project.pbxproj. The project's own
# signing settings name the match profile, as build_app relies on too. Returns the .ipa's path.
def archive_with_xcodebuild(project, bundle_id, build_number)
  out = File.join(ENV.fetch("RUNNER_TEMP", Dir.tmpdir), "build")
  FileUtils.rm_rf(out)
  archive = File.join(out, "#{PROJECT.fetch('scheme')}.xcarchive")
  sh("xcodebuild", "archive", "-project", project, "-scheme", PROJECT.fetch("scheme"),
     "-configuration", "Release", "-destination", "generic/platform=iOS", "-archivePath", archive,
     "CURRENT_PROJECT_VERSION=#{build_number}", "-quiet")

  options = File.join(out, "ExportOptions.plist")
  File.write(options, {
    "method" => "app-store-connect",
    "teamID" => PROJECT.fetch("team_id"),
    "signingStyle" => "manual",
    "provisioningProfiles" => { bundle_id => "match AppStore #{bundle_id}" },
    "uploadSymbols" => true
  }.to_plist)
  sh("xcodebuild", "-exportArchive", "-archivePath", archive, "-exportPath", out,
     "-exportOptionsPlist", options, "-quiet")

  ipa = Dir[File.join(out, "*.ipa")].first or UI.user_error!("The export made no .ipa in #{out}")
  lane_context[SharedValues::IPA_OUTPUT_PATH] = ipa
  ipa
end

platform :ios do
  lane :beta do
    bundle_id = PROJECT.fetch("bundle_id")

    # A leftover keychain from a crashed run would make create_keychain fail
    delete_keychain(name: KEYCHAIN) rescue nil

    # A throwaway keychain that never becomes your default, so your login keychain is untouched
    create_keychain(
      name: KEYCHAIN,
      password: ENV["MATCH_PASSWORD"],
      default_keychain: false,
      unlock: true,
      timeout: 3600
    )

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(type: "appstore", readonly: true, api_key: api_key,
          git_url: CERTS_REPO, storage_mode: "git",
          app_identifier: [bundle_id], team_id: PROJECT.fetch("team_id"),
          keychain_name: KEYCHAIN, keychain_password: ENV["MATCH_PASSWORD"])

    # Passed to xcodebuild rather than written into the project, so the checkout stays clean
    build_number = latest_testflight_build_number(api_key: api_key, app_identifier: bundle_id,
                                                  initial_build_number: 0) + 1
    File.write(File.join(PROJECT_DIR, ".build-number"), build_number.to_s)

    progress("Archiving build #{build_number}")
    project = File.join(PROJECT_DIR, PROJECT.fetch("xcodeproj"))
    ipa = if File.exist?(File.join(project, "project.pbxproj"))
            build_app(
              project: project,
              scheme: PROJECT.fetch("scheme"),
              export_method: "app-store",
              xcargs: "CURRENT_PROJECT_VERSION=#{build_number}"
            )
          else
            archive_with_xcodebuild(project, bundle_id, build_number)
          end

    progress("Uploading to TestFlight; Apple then processes the build")
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      app_identifier: bundle_id,
      changelog: ENV["WHAT_TO_TEST"].to_s[0, 3900]   # TestFlight's limit is 4000 characters
    )
  ensure
    delete_keychain(name: KEYCHAIN) rescue nil
  end
end
